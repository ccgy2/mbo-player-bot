# 기존 봇 토큰/Firebase 설정을 그대로 재사용하세요. 실제 값은 커밋하지 않습니다.
DISCORD_TOKEN=your_existing_discord_bot_token
FIREBASE_PROJECT_ID=your_existing_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_existing_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_EXISTING_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# 선수 관리 서버 ID (권장). 봇이 여러 서버에 있으면 명확한 서버 범위가 필요합니다.
DISCORD_ROSTER_GUILD_ID=

# 기존 반응 등록 설정. 원본의 메시지 기본값을 유지했습니다.
DISCORD_REACTION_ROSTER_MESSAGE_ID=1515707426421084321
DISCORD_REACTION_ROSTER_CHANNEL_ID=
DISCORD_REACTION_ROSTER_TEAM=무소속

# 선택: 선수 등록 역할 ID. 여러 개는 쉼표로 구분. 비우면 반응 등록만 사용합니다.
DISCORD_ROSTER_ROLE_IDS=

# 기존 공지/로그 채널 설정
DISCORD_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=

# 선택: Minecraft HTTP 웹훅. 사용하지 않으면 비워 둡니다.
MINECRAFT_WEBHOOK_SECRET=
MINECRAFT_WEBHOOK_PORT=8080
